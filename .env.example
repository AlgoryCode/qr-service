# Copy to `.env` (loaded via spring.config.import) or set in deployment.
# Monolith: payment and fulfillment run in-process — no PAYMENT_SERVICE_URL / FULFILLMENT_SERVICE_URL.

# Database
DB_URL=jdbc:postgresql://localhost:5432/algoryqrdb
DB_USERNAME=postgres
DB_PASSWORD=

# Server & app
SERVER_PORT=8080
APP_URL=http://localhost:3000
APP_SERVICE_NAME=qr-service
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT
JWT_SECRET=change-me-min-32-chars

# Google OAuth — register GOOGLE_CALLBACK_URL in Google Cloud Console (Authorized redirect URIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/google-auth/callback
GOOGLE_FRONTEND_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# RabbitMQ (menu, integration, smart report, optional payment event mirror)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# PayTR (when PAYMENT_GATEWAY_PROVIDER=PAYTR)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Storage (local Filer or production S3 — see DEPLOYMENT.md)
STORAGE_FILER_URL=http://localhost:8888
STORAGE_PUBLIC_BASE_URL=http://localhost:8888/buckets/qr-product-images
# STORAGE_S3_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
